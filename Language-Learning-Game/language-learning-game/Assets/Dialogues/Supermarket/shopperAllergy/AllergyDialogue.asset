  npcName: Allergic Customer
  dialogueElementList:
  - englishText: Hello
    pinyinText: "N\u01D0 h\u01CEo"
    chineseText: "\u4F60\u597D"
    dialogueAudio: {fileID: 8300000, guid: fc3e0e68c09f1094ab9a685426c44b9c, type: 3}
    hasChoice: 1
    choices:
    - englishChoice: Hello
      pinyinChoice: "N\u01D0 h\u01CEo"
      chineseChoice: "\u4F60\u597D"
      choiceAudio: {fileID: 8300000, guid: fc3e0e68c09f1094ab9a685426c44b9c, type: 3}
    nextElementID: 01000000
  - englishText: ' Excuse me, I want to buy a hamburger, does this peanuts?'
    pinyinText: "Du\xECb\xF9q\u01D0, w\u01D2 xi\u01CEng m\u01CEi h\xE0nb\u01CEob\u0101o,
      zh\xE8 y\u01D2u hu\u0101sh\u0113ng ma?"
    chineseText: "\u5BF9\u4E0D\u8D77\uFF0C\u6211\u60F3\u4E70\u6C49\u5821\u5305\uFF0C\u8FD9\u6709\u82B1\u751F\u5417\uFF1F"
    dialogueAudio: {fileID: 8300000, guid: 7a13a294c0f4374438ee0cabf21a1882, type: 3}
    hasChoice: 1
    choices:
    - englishChoice: Sorry, why are you asking?
      pinyinChoice: "Du\xECb\xF9q\u01D0, w\xE8ish\xE9me w\xE8n ma? "
      chineseChoice: "\u5BF9\u4E0D\u8D77\uFF0C\u4E3A\u4EC0\u4E48\u95EE\u5417\uFF1F"
      choiceAudio: {fileID: 8300000, guid: 0a7dc4abf1db5ad4d80c0d615cfabd41, type: 3}
    nextElementID: 02000000
  - englishText: I'm allergic to peanuts
    pinyinText: "W\u01D2 du\xEC hu\u0101sh\u0113ng gu\xF2m\u01D0n "
    chineseText: "\u6211\u5BF9\u82B1\u751F\u8FC7\u654F "
    dialogueAudio: {fileID: 8300000, guid: 3ab93cb2514e6fb4c8a7dd73c190e861, type: 3}
    hasChoice: 1
    choices:
    - englishChoice: 'Sorry, I don''t know '
      pinyinChoice: "B\xF9 h\u01CEoy\xECsi, w\u01D2 b\xF9 zh\u012Bd\xE0o "
      chineseChoice: "\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u4E0D\u77E5\u9053"
      choiceAudio: {fileID: 8300000, guid: 62ff8c90149a9b84189eb68b55fc79fd, type: 3}
    nextElementID: 03000000
  - englishText: 'Thanks '
    pinyinText: "Xi\xE8xi\xE8"
    chineseText: "\u8C22\u8C22"
    dialogueAudio: {fileID: 8300000, guid: 1324e00ccc7369046a1fa2fe3eb4869d, type: 3}
    hasChoice: 1
    choices:
    - englishChoice: 'You''re welcome '
      pinyinChoice: "B\xF9 k\xE8q\xEC "
      chineseChoice: "\u4E0D\u5BA2\u6C14"
      choiceAudio: {fileID: 8300000, guid: 34ce796b43f65d24e9650952594b443d, type: 3}
    nextElementID: 04000000
