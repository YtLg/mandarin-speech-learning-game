    nextElementID: 02000000030000000400000005000000
  - englishText: I'm 12 this year!
    pinyinText: "W\u01D2 j\u012Bnni\xE1n sh\xED'\xE8r su\xEC "
    chineseText: "\u6211\u4ECA\u5E74\u5341\u4E8C\u5C81"
    dialogueAudio: {fileID: 8300000, guid: cb9e15ba1fa53e045a64d2c622383c4c, type: 3}
    hasChoice: 0
    choices: []
    nextElementID: 01000000
  - englishText: I like to eat chocolate! And you?
    pinyinText: "W\u01D2 x\u01D0hu\u0101n ch\u012B qi\u01CEok\xE8l\xEC! N\u01D0 ne? "
    chineseText: "\u6211\u559C\u6B22\u5403\u5DE7\u514B\u529B\uFF01\u4F60\u5462\uFF1F"
    dialogueAudio: {fileID: 8300000, guid: dba768abc0fff714681dbefd25e6f872, type: 3}
    hasChoice: 1
    choices:
    - englishChoice: I also like to eat chocolate!
      pinyinChoice: "W\u01D2 y\u011B x\u01D0hu\u0101n ch\u012B qi\u01CEok\xE8l\xEC "
      chineseChoice: "\u6211\u4E5F\u559C\u6B22\u5403\u5DE7\u514B\u529B"
      choiceAudio: {fileID: 8300000, guid: dba768abc0fff714681dbefd25e6f872, type: 3}
    - englishChoice: I like to eat apples!
      pinyinChoice: "W\u01D2 x\u01D0hu\u0101n ch\u012B p\xEDnggu\u01D2 "
      chineseChoice: "\u6211\u559C\u6B22\u5403\u82F9\u679C"
      choiceAudio: {fileID: 8300000, guid: c4b7caedc0f5405488bca644db55505b, type: 3}
    nextElementID: 0100000001000000
  - englishText: I like to drink juice! And you?
    pinyinText: "W\u01D2 x\u01D0hu\u0101n h\u0113 gu\u01D2zh\u012B, n\u01D0 ne? "
    chineseText: "\u6211\u559C\u6B22\u559D\u679C\u6C41\uFF0C \u4F60\u5462\uFF1F"
