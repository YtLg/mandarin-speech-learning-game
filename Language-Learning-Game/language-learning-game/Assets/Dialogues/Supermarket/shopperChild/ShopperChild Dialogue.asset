    hasChoice: 1
    choices:
    - englishChoice: How old are you this year?
      pinyinChoice: "N\u01D0 j\u012Bnni\xE1n du\u014Dd\xE0? "
      chineseChoice: "\u4F60\u4ECA\u5E74\u591A\u5927\uFF1F"
      choiceAudio: {fileID: 8300000, guid: 4c8b4d3cc45350640a8292756e29c9c1, type: 3}
    - englishChoice: What do you like to eat?
      pinyinChoice: "N\u01D0 x\u01D0hu\u0101n ch\u012B sh\xE9nme? "
      chineseChoice: "\u4F60\u559C\u6B22\u5403\u4EC0\u4E48\uFF1F"
