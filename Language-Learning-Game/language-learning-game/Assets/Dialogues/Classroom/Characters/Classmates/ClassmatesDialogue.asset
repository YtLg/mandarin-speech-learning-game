      choiceAudio: {fileID: 8300000, guid: d075e15a096aedf4eb21312426c86be1, type: 3}
    - englishChoice: What are your names?
      pinyinChoice: "N\u01D0men ji\xE0o sh\xE9nme m\xEDngz\xEC? "
      chineseChoice: "\u4F60\u4EEC\u53EB\u4EC0\u4E48\u540D\u5B57\uFF1F"
